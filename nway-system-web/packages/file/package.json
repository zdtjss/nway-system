{
  "name": "@nway/file",
  "version": "1.0.0",
  "description": "nway-system 文件中心 SDK：零依赖客户端（上传、查询、票据、下载）+ Vue 3 组件（上传列表、图片/视频/PDF 预览）",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./vue": {
      "types": "./src/vue/index.ts",
      "import": "./src/vue/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "license": "UNLICENSED"
}

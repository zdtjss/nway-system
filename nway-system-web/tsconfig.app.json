{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.js",
    "packages/file/src/**/*.ts",
    "packages/file/src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nway/file/vue": [
        "./packages/file/src/vue/index.ts"
      ],
      "@nway/file": [
        "./packages/file/src/index.ts"
      ]
    }
  }
}
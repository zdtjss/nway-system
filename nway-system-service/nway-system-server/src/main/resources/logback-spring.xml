<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志目录，可通过环境变量 LOG_PATH 覆盖，默认 ${user.dir}/logs -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{tenantId:-},%X{employeeId:-}] %logger{36} -%kvp- %msg%n"/>

    <!-- 控制台可读输出（开发环境 local profile 使用），包含 MDC 中的 traceId/tenantId/employeeId -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- JSON 结构化控制台输出（非 local 环境使用，便于日志采集），LogstashEncoder 默认包含全部 MDC 字段（traceId/tenantId/employeeId） -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <customFields>{"app":"nway-system"}</customFields>
        </encoder>
    </appender>

    <!-- 可读文本文件输出，按天 + 100MB 滚动，保留 30 天，总量上限 5GB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/nway-system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/nway-system.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- JSON 结构化文件输出，滚动策略同上 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/nway-system-json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/nway-system-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <customFields>{"app":"nway-system"}</customFields>
        </encoder>
    </appender>

    <logger name="com.nway.spring.jdbc" level="debug"/>
    <logger name="org.springframework.web" level="debug"/>
    <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestResponseBodyMethodProcessor" level="error"/>

    <!-- 开发环境（local）控制台 + 文件 双输出 -->
    <springProfile name="local">
        <root level="info">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 非 local 环境（test/docker/prod）JSON 控制台 + JSON 文件 双输出 -->
    <springProfile name="!local">
        <root level="info">
            <appender-ref ref="JSON"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>
</configuration>
